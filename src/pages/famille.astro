---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import T from '../components/T.astro';
import { apps } from '../data/apps';
import { ui } from '../data/ui';

// Le logo de LightScrapVidz existe mais l'app n'apparaît nulle part (voir handoff).
---
<Base title="La famille" path="famille/" description={ui.famSub.en}>
  <section class="wrap" style="padding-top:72px">
    <h1 class="h1"><T t={ui.famTitle} /></h1>
    <p class="lede"><T t={ui.famSub} /></p>
    <div class="fam">
      {apps.map((a) => (
        <div style={`--h:${a.h1}`}>
          <Logo app={a.id} size={112} />
          <div class="sizes">
            <Logo app={a.id} size={32} /><Logo app={a.id} size={20} /><Logo app={a.id} size={16} />
          </div>
          <div class="nm">{a.name}</div>
        </div>
      ))}
    </div>
  </section>
  <div style="height:128px"></div>
</Base>
