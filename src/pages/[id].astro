---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import T from '../components/T.astro';
import { apps, type App } from '../data/apps';
import { ui } from '../data/ui';
import { u } from '../data/url';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}
const { app } = Astro.props as { app: App };
const others = apps.filter((a) => a.id !== app.id);
const tabs = [
  ['overview', ui.tabs.overview],
  ['features', ui.tabs.features],
  ['examples', ui.tabs.examples],
  ['install', ui.tabs.install],
  ['uninstall', ui.tabs.uninstall],
] as const;
// Capture réelle : déposer public/screenshots/{id}.png pour l'afficher dans Présentation.
const shot = existsSync(`public/screenshots/${app.id}.png`) ? u(`screenshots/${app.id}.png`) : null;
const style = `--h:${app.h1};--h2:${app.h2}`;
---
<Base title={app.name} path={`${app.id}/`} description={app.tagline.en} image={app.id}>
  <div style={style}>
    <section class="ahero">
      <div class="wrap ahero-in">
        <div>
          <div class="crumbs mono"><a href={u()}>light app suite</a> / <a href={u('apps/')}>apps</a> / {app.name}</div>
          <div class="num mono">{app.n} — <T t={app.kind} /></div>
          <h1>{app.name}</h1>
          <p class="tag"><T t={app.tagline} /></p>
          <div class="cta">
            <a href="#install" class="btn b-dark" data-tab="install"><T t={ui.installBtn} /></a>
            <a href={app.repo} class="btn b-out">GitHub</a>
          </div>
        </div>
        <div class="logo-big"><div><Logo app={app.id} size={300} /></div></div>
      </div>
    </section>

    <div class="tabbar">
      <div class="wrap" role="tablist">
        {tabs.map(([k, label], i) => (
          <button type="button" role="tab" id={`tab-${k}`} aria-controls={`panel-${k}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={k}><T t={label} /></button>
        ))}
      </div>
    </div>

    <div class="wrap panels">
      <div class="panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview">
        <div class="two">
          <div class="paras">
            {app.paras.fr.map((_, i) => <p><T t={{ fr: app.paras.fr[i], en: app.paras.en[i] }} /></p>)}
            {shot && <img class="shot" src={shot} alt={app.name} loading="lazy" />}
          </div>
          <div class="card">
            <div class="first"><div class="k mono"><T t={ui.platforms} /></div><div class="v"><T t={app.platform} /></div></div>
            <div><div class="k mono"><T t={ui.licenseLabel} /></div><div class="v">MIT</div></div>
            <div>
              <div class="k mono" style="margin-bottom:10px"><T t={ui.req} /></div>
              <ul>{app.reqs.map((r) => <li><T t={r} /></li>)}</ul>
            </div>
          </div>
        </div>
      </div>

      <div class="panel" role="tabpanel" id="panel-features" aria-labelledby="tab-features" hidden>
        <div class="feats">
          {app.features.map((f) => (
            <div><div class="big">{f.n}</div><div class="t"><T t={f.title} /></div><div class="b"><T t={f.body} /></div></div>
          ))}
        </div>
      </div>

      <div class="panel" role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" hidden>
        {app.examples.map((e) => (
          <div class="ex">
            <div><div class="n mono">{e.n}</div><div class="t"><T t={e.title} /></div></div>
            <div class="steps">
              {e.steps.fr.map((_, j) => (
                <div><span class="i mono">{String(j + 1).padStart(2, '0')}</span><span class="x"><T t={{ fr: e.steps.fr[j], en: e.steps.en[j] }} /></span></div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="panel" role="tabpanel" id="panel-install" aria-labelledby="tab-install" hidden>
        <div class="oneliner">
          <div class="body">
            <div class="lbl mono"><T t={ui.oneCmd} /></div>
            <code><i>$ </i>{app.command}</code>
          </div>
          <button type="button" class="copy" data-copy={app.command}><span class="idle"><T t={ui.copy} /></span><span class="done"><T t={ui.copied} /></span></button>
        </div>
        <p class="rerun"><T t={ui.rerun} /></p>
        <h3 class="h3"><T t={ui.manual} /></h3>
        <div class="blocks">
          {app.install.map((b) => (
            <div class="block"><div class="t"><T t={b.title} /></div><pre><T t={b.code} /></pre></div>
          ))}
        </div>
      </div>

      <div class="panel" role="tabpanel" id="panel-uninstall" aria-labelledby="tab-uninstall" hidden>
        <div class="blocks">
          {app.uninstall.map((b) => (
            <div class="block"><div class="t"><T t={b.title} /></div><pre><T t={b.code} /></pre></div>
          ))}
        </div>
      </div>
    </div>

    <section class="wrap others">
      <h2><T t={ui.others} /></h2>
      <div class="g">
        {others.map((a) => (
          <a href={u(`${a.id}/`)} class="tint" style={`--h:${a.h1}`}><Logo app={a.id} size={44} />{a.name}</a>
        ))}
      </div>
    </section>
  </div>

  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const keys = tabs.map((t) => t.dataset.tab!);
    const show = (k: string, top = true) => {
      if (!keys.includes(k)) k = keys[0];
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === k)));
      keys.forEach((id) => (document.getElementById(`panel-${id}`)!.hidden = id !== k));
      if (top) window.scrollTo({ top: 0 });
    };
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        history.replaceState(null, '', t.dataset.tab === keys[0] ? location.pathname : `#${t.dataset.tab}`);
        show(t.dataset.tab!);
      }),
    );
    document.querySelectorAll<HTMLAnchorElement>('a[data-tab]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(null, '', a.getAttribute('href'));
        show(a.dataset.tab!);
      }),
    );
    show(location.hash.slice(1), false);
    addEventListener('hashchange', () => show(location.hash.slice(1)));
  </script>
</Base>
